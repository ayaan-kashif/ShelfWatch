# Browser-safe Supabase settings. Copy to .env.local and fill only your project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only connection (Supabase transaction pooler or direct Postgres URL).
DATABASE_URL=
# Session pooler (5432) or direct URL for migrations; keep server-only.
DIRECT_URL=
# Database TLS is always certificate-verified for non-local hosts using the bundled Supabase root
# (certs/supabase-root-2021.crt). Override only for a different trusted chain:
# DATABASE_CA_CERT (PEM text, runtime) and DATABASE_CA_CERT_PATH (file, Prisma CLI). Public certificates, not secrets.
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=
# Server-only new Supabase secret key (sb_secret_...) for private Storage; never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=shelfwatch-photos
# Optional packaging analysis. Photos are sent to this provider only after explicit submission.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# Server-side global packaging request ceiling per UTC day (0 pauses paid analysis).
OPENAI_DAILY_ANALYSIS_LIMIT=50
# Public deployment origin (no trailing slash); used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Scheduled maintenance (retention, account deletion, rate-limit cleanup). 32+ random characters.
# Call GET/POST /api/cron/maintenance with "Authorization: Bearer <CRON_SECRET>" once a day.
CRON_SECRET=
# Alert notifications (optional). Webhook must be HTTPS; secret 32+ characters, used for HMAC signatures.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# Email alerts through Resend (optional). ALERT_EMAIL_TO accepts a comma-separated list.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Cloudflare Turnstile human check on sign-in, sign-up, recovery and phone codes (optional; both or neither).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Phone (SMS code) sign-in. Set to true only after an SMS provider is configured in Supabase Auth.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false
# WhatsApp bot worker (npm run whatsapp). Salt: 16+ random characters; never change it after launch.
WHATSAPP_HASH_SALT=
# Optional: link with a pairing code instead of a QR (digits with country code, e.g. 923001234567).
WHATSAPP_PAIRING_NUMBER=
WHATSAPP_AUTH_DIR=whatsapp/.auth
